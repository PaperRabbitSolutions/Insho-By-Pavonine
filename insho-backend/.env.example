# INSHO Backend Environment Configuration

# Development PostgreSQL database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/insho_db

# Dedicated testing PostgreSQL database
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/insho_test_db

# Opaque bearer sessions expire after this many minutes (5–1440).
AUTH_SESSION_TTL_MINUTES=30

# AI orchestration. Provider keys remain server-side; unset key disables live execution.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_ENABLED=true
AI_OPENAI_MODELS=gpt-4.1-mini
# Capabilities are explicit; unknown capabilities are never assumed.
AI_OPENAI_CAPABILITIES=text
AI_ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_API_VERSION=2026-10-21
AI_PROVIDER_ORDER=openai,anthropic
# Set an explicit model allowlist before enabling Anthropic; no model is assumed.
# AI_ANTHROPIC_MODELS=
# AI_ANTHROPIC_CAPABILITIES=text
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
# Optional verified pricing configuration by exact model identifier, USD per million tokens.
# Leave unset when unknown. Context limits are also optional model-id keyed JSON metadata.
# Keys may be `provider:model` or model ID (e.g. `openai:configured-model`).
# AI_MODEL_PRICING_JSON={"openai:configured-model":{"input_per_million":0.0,"output_per_million":0.0}}
# AI_MODEL_CONTEXT_LIMITS_JSON={"openai:configured-model":100000}

# Private local file storage. The directory is not publicly served.
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=104857600
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.png,.webp,.mp4,.pdf,.svg
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,application/pdf,image/svg+xml

# Celery media processing (Redis is an external development dependency).
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
VIDEO_PROCESSING_TIMEOUT_SECONDS=30
IMAGE_MAX_PIXELS=24000000
PROCESSING_MAX_SOURCE_BYTES=125829120
CELERY_WORKER_CONCURRENCY=2
